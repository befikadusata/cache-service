# Generate a random hexadecimal password locally; never commit the populated .env.
DB_PASS=
DB_HOST=127.0.0.1
DB_USER=cache
DB_NAME=cache
DB_PORT=5432
# Optional full connection URL override; omit when using DB_* settings.
POOL_SIZE=10
POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_SECONDS=5
MAX_LIST_ITEMS=100
MAX_STRING_CHARACTERS=10000
MAX_TOTAL_CHARACTERS=100000
GENERATION_TIMEOUT_SECONDS=60
READ_TIMEOUT_SECONDS=10
